{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "google-apps-script"]
  },
  "include": ["src/**/*.ts", "*.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
